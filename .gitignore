# Ignore everything except repository-related files by default,
# as unconfigured apps may also be storing data in ~/.config.
*
!.gitignore
!LICENSE
!README.md

!starship.toml

!.zshrc
!/zsh/
!/zsh/**
/zsh/environment.sh

!/ghostty/
!/ghostty/**

!/tmux/
!/tmux/**
/tmux/plugins/**
/tmux/plugins/tpm/

!/nvim/
!/nvim/**

!/lazygit/
!/lazygit/**

!/zk/
!/zk/**
